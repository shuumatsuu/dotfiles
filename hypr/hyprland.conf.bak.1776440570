# Ensure the XDG portal can get the required variables on startup
exec-once=dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

source = /home/lin/.config/hypr/noctalia/noctalia-colors.conf



monitor=DP-1,3440x1440@120.00,1920x-192,1.00
monitor=HDMI-A-1,1920x1080@120.00,0x210,1.00
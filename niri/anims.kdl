// https://niri-wm.github.io/niri/Configuration:-Animations
animations {
	workspace-switch {
		spring damping-ratio=0.42 stiffness=629 epsilon=0.0001
	}

	window-open {
		spring damping-ratio=0.42 stiffness=629 epsilon=0.0001
	}
	window-close {
		spring damping-ratio=0.42 stiffness=629 epsilon=0.0001
	}
}
